# ==========================================
# ZonaGol - Backend
# ==========================================

# Servidor
PORT=5000

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ZonaGolAuth
DB_USER=sa
DB_PASSWORD=YOUR_SQLSERVER_PASSWORD
DB_ENCRYPT=false

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_DATABASE=zonagol_negocio
MYSQL_SSL=false

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=zonagol

# Firebase
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-zonagol.json
FIREBASE_PROJECT_ID=zonagol-63bfc


# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=zonagol_postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD
POSTGRES_SSL=false

# Correo
EMAIL_USER=soporte.zonagol@gmail.com
EMAIL_APP_PASSWORD=YOUR_EMAIL_APP_PASSWORD

# JWT
JWT_SECRET=YOUR_JWT_SECRET
JWT_EXPIRES_IN=2h

# Google Sign-In
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

# API-Football
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

SPORTS_SYNC_ENABLED=true
SPORTS_SYNC_CRON="0 */2 * * *"

SPORTS_SYNC_LEAGUE_ID=239
SPORTS_SYNC_SEASON=2024
SPORTS_SYNC_ROUND="Apertura - 1"
SPORTS_SYNC_NUMERO_JORNADA=1

# Wompi
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=YOUR_WOMPI_PUBLIC_KEY
WOMPI_PRIVATE_KEY=YOUR_WOMPI_PRIVATE_KEY
WOMPI_INTEGRITY_SECRET=YOUR_WOMPI_INTEGRITY_SECRET
WOMPI_EVENTS_SECRET=YOUR_WOMPI_EVENTS_SECRET


# Google Drive OAuth2
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/google-drive/oauth/callback
GOOGLE_DRIVE_REFRESH_TOKEN=YOUR_GOOGLE_DRIVE_REFRESH_TOKEN
GOOGLE_DRIVE_PROFILES_FOLDER_ID=1GDVSQMADoeKFbW-Zai7I_oPdGug2-Oz7
